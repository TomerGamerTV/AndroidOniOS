+    void Visit(V& v) { v.io(contexts_); v.io(resources_); v.io(timelines_); }
+};
+
+static constexpr uint64_t kShimMagic = 0x4746585348494d31ull;  // "GFXSHIM1"
+
+template <typename M>
+bool ShimSaveToFile(const M& msg, const char* path) {
+    ShimWriter w;
+    uint64_t magic = kShimMagic;
+    w.io(magic);
+    const_cast<M&>(msg).Visit(w);
+    FILE* f = fopen(path, "wb");
+    if (!f) return false;
+    bool ok = fwrite(w.out.data(), 1, w.out.size(), f) == w.out.size();
+    return fclose(f) == 0 && ok;
+}
+
+template <typename M>
+bool ShimLoadFromFile(M* msg, const char* path) {
+    FILE* f = fopen(path, "rb");
+    if (!f) return false;
+    std::string data;
+    char buf[65536];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof(buf), f)) > 0) data.append(buf, n);
+    fclose(f);
+    ShimReader r(data);
+    uint64_t magic = 0;
+    r.io(magic);
+    if (!r.ok || magic != kShimMagic) return false;
+    msg->Visit(r);
+    return r.ok;
+}
