+class VirtioGpuResourceSnapshot {
+    GFXSTREAM_SHIM_SCALAR(uint32_t, id)
+    GFXSTREAM_SHIM_SCALAR(VirtioGpuResourceType, type)
+    GFXSTREAM_SHIM_MESSAGE(VirtioGpuResourceCreateArgs, create_args)
+    GFXSTREAM_SHIM_MESSAGE(VirtioGpuResourceCreateBlobArgs, create_blob_args)
+    GFXSTREAM_SHIM_MESSAGE(VirtioGpuRingBlobSnapshot, ring_blob)
+    GFXSTREAM_SHIM_MESSAGE(VirtioGpuBlobExternalMemoryInfo, external_memory_descriptor)
+    GFXSTREAM_SHIM_MESSAGE(VirtioGpuBlobExternalMemoryInfo, external_memory_mapping)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, latest_attached_context)
+    GFXSTREAM_SHIM_REPEATED(uint32_t, attached_contexts)
+   public:
+    GFXSTREAM_SHIM_SWAP(VirtioGpuResourceSnapshot)
+    template <typename V>
+    void Visit(V& v) {
+        v.io(id_); v.io(type_); v.io(create_args_); v.io(create_blob_args_); v.io(ring_blob_);
+        v.io(external_memory_descriptor_); v.io(external_memory_mapping_);
+        v.io(latest_attached_context_); v.io(attached_contexts_);
+    }
+};
