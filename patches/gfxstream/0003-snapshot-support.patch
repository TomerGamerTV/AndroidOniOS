+class VirtioGpuFrontendSnapshot {
+    GFXSTREAM_SHIM_MAP(uint32_t, VirtioGpuContextSnapshot, contexts)
+    GFXSTREAM_SHIM_MAP(uint32_t, VirtioGpuResourceSnapshot, resources)
+    GFXSTREAM_SHIM_MESSAGE(VirtioGpuTimelinesSnapshot, timelines)
+   public:
