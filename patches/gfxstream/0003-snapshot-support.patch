@@ -0,0 +1,414 @@
+// Protobuf-free stand-ins for the virtio-gpu frontend snapshot messages
+// (virtio_gpu_*_snapshot.proto). They expose the subset of the generated protobuf C++ API
+// that the frontend uses, and serialize to a compact private binary format, so snapshot support
+// builds without protobuf/abseil (which we would otherwise have to port to iOS).
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <optional>
+#include <string>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+namespace gfxstream {
+namespace host {
+namespace snapshot {
+
+template <typename T>
+class Repeated : public std::vector<T> {
+   public:
+    template <typename It>
+    void Add(It begin, It end) {
+        this->insert(this->end(), begin, end);
+    }
+    void Add(T value) { this->push_back(std::move(value)); }
+};
+
+class ShimWriter {
+   public:
+    std::string out;
+    void raw(const void* p, size_t n) { out.append(static_cast<const char*>(p), n); }
+    void io(bool& v) { uint8_t b = v; raw(&b, 1); }
+    void io(uint32_t& v) { raw(&v, 4); }
+    void io(uint64_t& v) { raw(&v, 8); }
+    void io(std::string& s) {
+        uint64_t n = s.size();
+        io(n);
+        raw(s.data(), s.size());
+    }
+    template <typename E>
+    std::enable_if_t<std::is_enum_v<E>> io(E& e) {
+        uint32_t v = static_cast<uint32_t>(e);
+        io(v);
+    }
+    template <typename M>
+    auto io(M& m) -> decltype(m.Visit(*this), void()) { m.Visit(*this); }
+    template <typename T>
+    void io(std::optional<T>& o) {
+        bool has = o.has_value();
+        io(has);
+        if (has) io(*o);
+    }
+    template <typename T>
+    void io(Repeated<T>& r) {
+        uint64_t n = r.size();
+        io(n);
+        for (auto& e : r) io(e);
+    }
+    template <typename K, typename V>
+    void io(std::map<K, V>& m) {
+        uint64_t n = m.size();
+        io(n);
+        for (auto& [k, v] : m) {
+            K key = k;
+            io(key);
+            io(v);
+        }
+    }
+};
+
+class ShimReader {
+   public:
+    ShimReader(const std::string& s) : p(s.data()), end(s.data() + s.size()) {}
+    bool ok = true;
+    void raw(void* dst, size_t n) {
+        if (!ok || static_cast<size_t>(end - p) < n) { ok = false; return; }
+        std::memcpy(dst, p, n);
+        p += n;
+    }
+    void io(bool& v) { uint8_t b = 0; raw(&b, 1); v = b; }
+    void io(uint32_t& v) { raw(&v, 4); }
+    void io(uint64_t& v) { raw(&v, 8); }
+    void io(std::string& s) {
+        uint64_t n = 0;
+        io(n);
+        if (!ok || static_cast<uint64_t>(end - p) < n) { ok = false; return; }
+        s.assign(p, n);
+        p += n;
+    }
+    template <typename E>
+    std::enable_if_t<std::is_enum_v<E>> io(E& e) {
+        uint32_t v = 0;
+        io(v);
+        e = static_cast<E>(v);
+    }
+    template <typename M>
+    auto io(M& m) -> decltype(m.Visit(*this), void()) { m.Visit(*this); }
+    template <typename T>
+    void io(std::optional<T>& o) {
+        bool has = false;
+        io(has);
+        if (!ok) return;
+        if (has) { o.emplace(); io(*o); } else { o.reset(); }
+    }
+    template <typename T>
+    void io(Repeated<T>& r) {
+        uint64_t n = 0;
+        io(n);
+        r.clear();
+        for (uint64_t i = 0; ok && i < n; i++) { r.emplace_back(); io(r.back()); }
+    }
+    template <typename K, typename V>
+    void io(std::map<K, V>& m) {
+        uint64_t n = 0;
+        io(n);
+        m.clear();
+        for (uint64_t i = 0; ok && i < n; i++) {
+            K k{};
+            io(k);
+            io(m[k]);
+        }
+    }
+
+   private:
+    const char* p;
+    const char* end;
+};
+
+#define GFXSTREAM_SHIM_SCALAR(type, name)                                     \
+   private:                                                                   \
+    std::optional<type> name##_;                                              \
+                                                                              \
+   public:                                                                    \
+    type name() const { return name##_.value_or(type{}); }                    \
+    void set_##name(type v) { name##_ = v; }                                  \
+    bool has_##name() const { return name##_.has_value(); }
+
+#define GFXSTREAM_SHIM_MESSAGE(type, name)                                    \
+   private:                                                                   \
+    std::optional<type> name##_;                                              \
+                                                                              \
+   public:                                                                    \
+    const type& name() const {                                                \
+        static const type kDefault{};                                         \
+        return name##_ ? *name##_ : kDefault;                                 \
+    }                                                                         \
+    type* mutable_##name() {                                                  \
+        if (!name##_) name##_.emplace();                                      \
+        return &*name##_;                                                     \
+    }                                                                         \
+    bool has_##name() const { return name##_.has_value(); }
+
+#define GFXSTREAM_SHIM_REPEATED(type, name)                                   \
+   private:                                                                   \
+    Repeated<type> name##_;                                                   \
+                                                                              \
+   public:                                                                    \
+    const Repeated<type>& name() const { return name##_; }                    \
+    Repeated<type>* mutable_##name() { return &name##_; }
+
+#define GFXSTREAM_SHIM_MAP(ktype, vtype, name)                                \
+   private:                                                                   \
+    std::map<ktype, vtype> name##_;                                           \
+                                                                              \
+   public:                                                                    \
+    const std::map<ktype, vtype>& name() const { return name##_; }            \
+    std::map<ktype, vtype>* mutable_##name() { return &name##_; }
+
+#define GFXSTREAM_SHIM_SWAP(type) \
+    void Swap(type* other) { std::swap(*this, *other); }
+
+// virtio_gpu_context_snapshot.proto
+class VirtioGpuContextSnapshot {
+    GFXSTREAM_SHIM_SCALAR(uint32_t, id)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, capset)
+    GFXSTREAM_SHIM_REPEATED(uint32_t, attached_resources)
+    GFXSTREAM_SHIM_MAP(uint32_t, uint32_t, resource_asgs)
+   private:
+    std::string name_;
+
+   public:
+    const std::string& name() const { return name_; }
+    void set_name(const std::string& v) { name_ = v; }
+    GFXSTREAM_SHIM_SWAP(VirtioGpuContextSnapshot)
+    template <typename V>
+    void Visit(V& v) {
+        v.io(id_);
+        v.io(name_);
+        v.io(capset_);
+        v.io(attached_resources_);
+        v.io(resource_asgs_);
+    }
+};
+
+// virtio_gpu_ring_blob_snapshot.proto
+class VirtioGpuRingBlobSnapshot {
+   public:
+    enum Type : uint32_t { TYPE_HOST_MEMORY = 0, TYPE_SHARED_MEMORY = 1 };
+    GFXSTREAM_SHIM_SCALAR(uint32_t, id)
+    GFXSTREAM_SHIM_SCALAR(uint64_t, size)
+    GFXSTREAM_SHIM_SCALAR(uint64_t, alignment)
+    GFXSTREAM_SHIM_SCALAR(Type, type)
+   private:
+    std::string memory_;
+
+   public:
+    const std::string& memory() const { return memory_; }
+    void set_memory(const void* data, size_t size) {
+        memory_.assign(static_cast<const char*>(data), size);
+    }
+    GFXSTREAM_SHIM_SWAP(VirtioGpuRingBlobSnapshot)
+    template <typename V>
+    void Visit(V& v) {
+        v.io(id_);
+        v.io(size_);
+        v.io(alignment_);
+        v.io(type_);
+        v.io(memory_);
+    }
+};
+
+// virtio_gpu_resource_snapshot.proto
+enum VirtioGpuResourceType : uint32_t {
+    UNKNOWN = 0,
+    PIPE = 1,
+    BUFFER = 2,
+    COLOR_BUFFER = 3,
+    BLOB = 4,
+};
+
+class VirtioGpuResourceCreateArgs {
+    GFXSTREAM_SHIM_SCALAR(uint32_t, id)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, target)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, format)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, bind)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, width)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, height)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, depth)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, array_size)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, last_level)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, nr_samples)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, flags)
+   public:
+    template <typename V>
+    void Visit(V& v) {
+        v.io(id_); v.io(target_); v.io(format_); v.io(bind_); v.io(width_); v.io(height_);
+        v.io(depth_); v.io(array_size_); v.io(last_level_); v.io(nr_samples_); v.io(flags_);
+    }
+};
+
+class VirtioGpuResourceCreateBlobArgs {
+    GFXSTREAM_SHIM_SCALAR(uint32_t, mem)
+    GFXSTREAM_SHIM_SCALAR(uint32_t, flags)
+    GFXSTREAM_SHIM_SCALAR(uint64_t, id)
+    GFXSTREAM_SHIM_SCALAR(uint64_t, size)
+   public:
+    template <typename V>
+    void Visit(V& v) { v.io(mem_); v.io(flags_); v.io(id_); v.io(size_); }
+};
+
+class VirtioGpuBlobExternalMemoryInfo {
+    GFXSTREAM_SHIM_SCALAR(uint32_t, context_id)
+    GFXSTREAM_SHIM_SCALAR(uint64_t, blob_id)
+   public:
+    template <typename V>
+    void Visit(V& v) { v.io(context_id_); v.io(blob_id_); }
+};
