diff --git a/host/gl/glestranslator/egl/ios_native.mm b/host/gl/glestranslator/egl/ios_native.mm
new file mode 100644
index 0000000..12e4e7e
--- /dev/null
+++ b/host/gl/glestranslator/egl/ios_native.mm
@@ -0,0 +1,25 @@
+// iOS: native windows are CALayers; host GL always goes through EGL (ANGLE).
+#import <QuartzCore/QuartzCore.h>
+#include "ios_native.h"
+#include "egl_os_api.h"
+
+extern "C" bool nsGetWinDims(void* win, unsigned int* width, unsigned int* height) {
+    if (!win) return false;
+    CALayer* layer = (__bridge CALayer*)win;
+    CGSize size = layer.bounds.size;
+    CGFloat scale = layer.contentsScale;
+    *width = (unsigned int)(size.width * scale);
+    *height = (unsigned int)(size.height * scale);
+    return true;
+}
+
+extern "C" bool nsCheckColor(void* win, int colorSize) { return true; }
+
+extern "C" void* nsGetLayer(void* nativeWin) { return nativeWin; }
+
+EglOS::Engine* EglOS::Engine::createHostInstance() {
+    return EglOS::getEgl2EglHostInstance(false);
+}
+
+// Used by the host video decoder path on macOS only; never reached on iOS.
+extern "C" void nsConvertVideoFrameToNV12Textures(void* context, void* iosurface, int Ytex, int UVtex) {}
