+/*
+ * Migration / snapshot support.
+ *
+ * The parent virtio-gpu vmstate only knows 2D resources (it dumps pixman images), so rutabaga
+ * gets its own: the virtio core, QEMU's resource list (guest backing addresses, scanout images),
+ * blob mappings in the hostmem BAR, commands still waiting for a fence, and the renderer state
+ * from rutabaga_snapshot(), which gfxstream writes as a directory tree that we embed here.
+ */
+#define RUTABAGA_MIG_MAGIC 0x52544247u /* "RTBG" */
+#define RUTABAGA_MIG_CHUNK (1 << 20)
+
+enum { MIG_TREE_END = 0, MIG_TREE_DIR = 1, MIG_TREE_FILE = 2 };
+
+static int rutabaga_put_tree(QEMUFile *f, const char *base, const char *rel)
+{
+    g_autofree char *dirpath = rel[0] ? g_build_filename(base, rel, NULL)
+                                      : g_strdup(base);
+    GDir *dir = g_dir_open(dirpath, 0, NULL);
+    const char *name;
+
+    if (!dir) {
+        return -errno;
+    }
+    while ((name = g_dir_read_name(dir))) {
+        g_autofree char *child_rel = rel[0] ? g_build_filename(rel, name, NULL)
+                                            : g_strdup(name);
+        g_autofree char *path = g_build_filename(base, child_rel, NULL);
+        size_t len = strlen(child_rel);
+
+        if (g_file_test(path, G_FILE_TEST_IS_DIR)) {
+            qemu_put_byte(f, MIG_TREE_DIR);
+            qemu_put_be32(f, len);
+            qemu_put_buffer(f, (const uint8_t *)child_rel, len);
+            int ret = rutabaga_put_tree(f, base, child_rel);
+            if (ret) {
+                g_dir_close(dir);
+                return ret;
+            }
+            continue;
+        }
+
+        FILE *in = fopen(path, "rb");
+        if (!in) {
+            g_dir_close(dir);
+            return -errno;
+        }
+        fseeko(in, 0, SEEK_END);
+        uint64_t size = ftello(in);
+        fseeko(in, 0, SEEK_SET);
+        qemu_put_byte(f, MIG_TREE_FILE);
+        qemu_put_be32(f, len);
+        qemu_put_buffer(f, (const uint8_t *)child_rel, len);
+        qemu_put_be64(f, size);
+        g_autofree uint8_t *buf = g_malloc(RUTABAGA_MIG_CHUNK);
+        uint64_t left = size;
+        while (left) {
+            size_t n = fread(buf, 1, MIN(left, RUTABAGA_MIG_CHUNK), in);
+            if (!n) {
+                break;
+            }
+            qemu_put_buffer(f, buf, n);
+            left -= n;
+        }
+        fclose(in);
+        if (left) {
+            g_dir_close(dir);
+            return -EIO;
+        }
+    }
+    g_dir_close(dir);
+    return 0;
+}
+
+static int rutabaga_get_tree(QEMUFile *f, const char *base)
+{
+    g_autofree uint8_t *buf = g_malloc(RUTABAGA_MIG_CHUNK);
+
+    for (;;) {
+        int type = qemu_get_byte(f);
+        if (type == MIG_TREE_END) {
+            return 0;
+        }
+        uint32_t len = qemu_get_be32(f);
+        if (len == 0 || len > 4096) {
+            return -EINVAL;
+        }
+        g_autofree char *rel = g_malloc0(len + 1);
+        qemu_get_buffer(f, (uint8_t *)rel, len);
+        if (rel[0] == '/' || strstr(rel, "..")) {
+            return -EINVAL;
+        }
+        g_autofree char *path = g_build_filename(base, rel, NULL);
+
+        if (type == MIG_TREE_DIR) {
+            if (g_mkdir_with_parents(path, 0700)) {
+                return -errno;
+            }
+            continue;
+        }
+        if (type != MIG_TREE_FILE) {
+            return -EINVAL;
+        }
+        uint64_t left = qemu_get_be64(f);
+        FILE *out = fopen(path, "wb");
+        if (!out) {
+            return -errno;
+        }
+        while (left) {
+            size_t n = MIN(left, RUTABAGA_MIG_CHUNK);
+            if (qemu_get_buffer(f, buf, n) != n || fwrite(buf, 1, n, out) != n) {
+                fclose(out);
+                return -EIO;
+            }
+            left -= n;
+        }
+        if (fclose(out)) {
+            return -errno;
+        }
+    }
+}
+
+static void rutabaga_rm_tree(const char *path)
+{
+    GDir *dir = g_dir_open(path, 0, NULL);
+    const char *name;
+
+    if (dir) {
+        while ((name = g_dir_read_name(dir))) {
+            g_autofree char *child = g_build_filename(path, name, NULL);
+            if (g_file_test(child, G_FILE_TEST_IS_DIR)) {
+                rutabaga_rm_tree(child);
+            } else {
+                unlink(child);
+            }
+        }
+        g_dir_close(dir);
+    }
+    rmdir(path);
+}
+
+static int virtio_gpu_rutabaga_save(QEMUFile *f, void *opaque, size_t size,
+                                    const VMStateField *field, JSONWriter *vmdesc)
+{
+    VirtIOGPU *g = opaque;
+    VirtIOGPUBase *vb = VIRTIO_GPU_BASE(g);
+    VirtIOGPURutabaga *vr = VIRTIO_GPU_RUTABAGA(g);
+    VirtIODevice *vdev = VIRTIO_DEVICE(g);
+    struct virtio_gpu_simple_resource *res;
+    struct virtio_gpu_ctrl_command *cmd;
+    unsigned int i;
+    int ret;
+
+    if (!QTAILQ_EMPTY(&g->cmdq)) {
+        error_report("virtio-gpu-rutabaga: cannot save with queued commands");
+        return -EBUSY;
+    }
+
+    qemu_put_be32(f, RUTABAGA_MIG_MAGIC);
+
+    QTAILQ_FOREACH(res, &g->reslist, next) {
+        qemu_put_be32(f, res->resource_id);
+        qemu_put_be32(f, res->width);
+        qemu_put_be32(f, res->height);
+        qemu_put_be32(f, res->format);
+        qemu_put_be64(f, res->blob_size);
+        qemu_put_be32(f, res->scanout_bitmask);
+        qemu_put_byte(f, res->image != NULL);
+        if (res->iov_cnt && !res->addrs) {
+            error_report("virtio-gpu-rutabaga: resource %u has no guest addresses",
+                         res->resource_id);
+            return -EINVAL;
+        }
+        qemu_put_be32(f, res->iov_cnt);
+        for (i = 0; i < res->iov_cnt; i++) {
+            qemu_put_be64(f, res->addrs[i]);
+            qemu_put_be64(f, res->iov[i].iov_len);
+        }
+    }
+    qemu_put_be32(f, 0);
+
+    for (i = 0; i < MAX_SLOTS; i++) {
+        MemoryRegion *mr = &vr->memory_regions[i].mr;
+        if (!vr->memory_regions[i].used) {
+            continue;
+        }
+        qemu_put_be32(f, vr->memory_regions[i].resource_id);
+        qemu_put_be64(f, mr->addr);
+    }
+    qemu_put_be32(f, 0);
+
+    QTAILQ_FOREACH(cmd, &g->fenceq, next) {
+        qemu_put_byte(f, 1);
+        qemu_put_virtqueue_element(vdev, f, &cmd->elem);
+        qemu_put_buffer(f, (const uint8_t *)&cmd->cmd_hdr, sizeof(cmd->cmd_hdr));
+    }
+    qemu_put_byte(f, 0);
+
+    /* Completions already signaled by the renderer, waiting for the main loop. */
+    qemu_mutex_lock(&vr->fence_lock);
+    qemu_put_be32(f, g_list_length(vr->queued_fences));
+    for (GList *l = vr->queued_fences; l; l = l->next) {
+        struct rutabaga_aio_data *data = l->data;
+        qemu_put_buffer(f, (const uint8_t *)&data->fence, sizeof(data->fence));
+    }
+    qemu_mutex_unlock(&vr->fence_lock);
+
+    qemu_put_be32(f, vb->enable);
+    for (i = 0; i < VIRTIO_GPU_MAX_SCANOUTS; i++) {
+        qemu_put_be32(f, vr->scanout_resource[i]);
+    }
+
+    g_autoptr(GError) err = NULL;
+    g_autofree char *dir = g_dir_make_tmp("droid-gpu-save-XXXXXX", &err);
+    if (!dir) {
+        error_report("virtio-gpu-rutabaga: %s", err->message);
+        return -EIO;
+    }
+    ret = rutabaga_snapshot(vr->rutabaga, dir);
+    if (ret) {
+        error_report("virtio-gpu-rutabaga: rutabaga_snapshot failed (%d)", ret);
+        rutabaga_rm_tree(dir);
+        return ret < 0 ? ret : -EIO;
+    }
+    ret = rutabaga_put_tree(f, dir, "");
+    qemu_put_byte(f, MIG_TREE_END);
+    rutabaga_rm_tree(dir);
+    if (ret) {
+        error_report("virtio-gpu-rutabaga: failed to store renderer state (%d)", ret);
+    }
+    return ret;
+}
+
+static int virtio_gpu_rutabaga_load(QEMUFile *f, void *opaque, size_t size,
+                                    const VMStateField *field)
+{
+    VirtIOGPU *g = opaque;
+    VirtIOGPUBase *vb = VIRTIO_GPU_BASE(g);
+    VirtIOGPURutabaga *vr = VIRTIO_GPU_RUTABAGA(g);
+    VirtIODevice *vdev = VIRTIO_DEVICE(g);
+    struct virtio_gpu_simple_resource *res;
+    uint32_t *map_res = NULL;
+    uint64_t *map_off = NULL;
+    unsigned int nmaps = 0, i;
+    uint32_t resource_id;
+    int ret;
+
+    if (qemu_get_be32(f) != RUTABAGA_MIG_MAGIC) {
+        return -EINVAL;
+    }
+
+    while ((resource_id = qemu_get_be32(f)) != 0) {
+        if (virtio_gpu_find_resource(g, resource_id)) {
+            return -EINVAL;
+        }
+        res = g_new0(struct virtio_gpu_simple_resource, 1);
+        res->resource_id = resource_id;
+        res->width = qemu_get_be32(f);
+        res->height = qemu_get_be32(f);
+        res->format = qemu_get_be32(f);
+        res->blob_size = qemu_get_be64(f);
+        res->scanout_bitmask = qemu_get_be32(f);
+        bool has_image = qemu_get_byte(f);
+        res->iov_cnt = qemu_get_be32(f);
+        if (res->iov_cnt > 1024 * 1024) {
+            g_free(res);
+            return -EINVAL;
+        }
+        if (res->iov_cnt) {
+            res->addrs = g_new0(uint64_t, res->iov_cnt);
+            res->iov = g_new0(struct iovec, res->iov_cnt);
+        }
+        for (i = 0; i < res->iov_cnt; i++) {
+            res->addrs[i] = qemu_get_be64(f);
+            res->iov[i].iov_len = qemu_get_be64(f);
+        }
+        if (has_image) {
+            pixman_format_code_t pformat = virtio_gpu_get_pixman_format(res->format);
+            if (pformat) {
+                res->image = pixman_image_create_bits(pformat, res->width,
+                                                      res->height, NULL, 0);
+                if (res->image) {
+                    pixman_image_ref(res->image); /* as rutabaga_cmd_set_scanout() */
+                }
+            }
+        }
+        /* Guest RAM is already loaded, so the backing can be mapped now. */
+        for (i = 0; i < res->iov_cnt; i++) {
+            hwaddr len = res->iov[i].iov_len;
+            res->iov[i].iov_base =
+                dma_memory_map(vdev->dma_as, res->addrs[i], &len,
+                               DMA_DIRECTION_TO_DEVICE, MEMTXATTRS_UNSPECIFIED);
+            if (!res->iov[i].iov_base || len != res->iov[i].iov_len) {
+                error_report("virtio-gpu-rutabaga: cannot map backing of resource %u",
+                             resource_id);
+                return -EINVAL;
+            }
+        }
+        QTAILQ_INSERT_HEAD(&g->reslist, res, next);
+    }
+
+    while ((resource_id = qemu_get_be32(f)) != 0) {
+        map_res = g_renew(uint32_t, map_res, nmaps + 1);
+        map_off = g_renew(uint64_t, map_off, nmaps + 1);
+        map_res[nmaps] = resource_id;
+        map_off[nmaps] = qemu_get_be64(f);
+        nmaps++;
+    }
+
+    while (qemu_get_byte(f)) {
+        struct virtio_gpu_ctrl_command *cmd =
+            qemu_get_virtqueue_element(vdev, f, sizeof(*cmd));
+        if (!cmd) {
+            return -EINVAL;
+        }
+        virtio_gpu_ctrl_cmd_init(cmd, virtio_get_queue(vdev, 0));
+        qemu_get_buffer(f, (uint8_t *)&cmd->cmd_hdr, sizeof(cmd->cmd_hdr));
+        QTAILQ_INSERT_TAIL(&g->fenceq, cmd, next);
+    }
+
+    uint32_t nfences = qemu_get_be32(f);
+    if (nfences > 65536) {
+        return -EINVAL;
+    }
+    if (!vr->restored_fences) {
+        vr->restored_fences = g_array_new(false, true, sizeof(struct rutabaga_fence));
+    }
+    for (i = 0; i < nfences; i++) {
+        struct rutabaga_fence fence;
+        qemu_get_buffer(f, (uint8_t *)&fence, sizeof(fence));
+        g_array_append_val(vr->restored_fences, fence);
+    }
+
+    vb->enable = qemu_get_be32(f);
+    for (i = 0; i < VIRTIO_GPU_MAX_SCANOUTS; i++) {
+        vr->scanout_resource[i] = qemu_get_be32(f);
+    }
+
+    g_autoptr(GError) err = NULL;
+    g_autofree char *dir = g_dir_make_tmp("droid-gpu-load-XXXXXX", &err);
+    if (!dir) {
+        error_report("virtio-gpu-rutabaga: %s", err->message);
+        return -EIO;
+    }
+    ret = rutabaga_get_tree(f, dir);
+    if (!ret) {
+        ret = rutabaga_restore(vr->rutabaga, dir);
+        if (ret) {
+            error_report("virtio-gpu-rutabaga: rutabaga_restore failed (%d)", ret);
+        }
+    }
+    rutabaga_rm_tree(dir);
+    if (ret) {
+        return ret < 0 ? ret : -EIO;
+    }
+
+    /* The renderer recreated its resources; hand them their guest backing again. */
+    QTAILQ_FOREACH(res, &g->reslist, next) {
+        struct rutabaga_iovecs vecs = { .iovecs = res->iov, .num_iovecs = res->iov_cnt };
+        if (!res->iov_cnt) {
+            continue;
+        }
+        ret = rutabaga_resource_attach_backing(vr->rutabaga, res->resource_id, &vecs);
+        if (ret) {
+            error_report("virtio-gpu-rutabaga: re-attach of resource %u failed (%d)",
+                         res->resource_id, ret);
+            return -EIO;
+        }
+    }
+
+    /*
+     * Host-visible blobs go back into the hostmem BAR at the guest's offsets once the VM starts:
+     * creating RAM regions is not allowed inside the incoming-migration coroutine.
+     */
+    g_free(vr->pending_map_res);
+    g_free(vr->pending_map_off);
+    vr->pending_map_res = map_res;
+    vr->pending_map_off = map_off;
+    vr->pending_maps = nmaps;
+    return 0;
+}
+
+static void virtio_gpu_rutabaga_vm_state_change(void *opaque, bool running,
+                                                RunState state)
+{
+    VirtIOGPURutabaga *vr = opaque;
+    VirtIOGPUBase *vb = VIRTIO_GPU_BASE(vr);
+    unsigned int i;
+
+    if (!running) {
+        return;
+    }
+    if (vr->restored_fences && vr->restored_fences->len) {
+        for (i = 0; i < vr->restored_fences->len; i++) {
+            virtio_gpu_rutabaga_complete_fence(
+                VIRTIO_GPU(vr), g_array_index(vr->restored_fences, struct rutabaga_fence, i));
+        }
+        g_array_set_size(vr->restored_fences, 0);
+    }
+    if (vr->refresh_pending) {
+        /* Show the last frame now instead of black until the guest flushes again. */
+        vr->refresh_pending = false;
+        for (i = 0; i < vb->conf.max_outputs && i < VIRTIO_GPU_MAX_SCANOUTS; i++) {
+            struct virtio_gpu_simple_resource *res =
+                virtio_gpu_find_resource(VIRTIO_GPU(vr), vr->scanout_resource[i]);
+            struct rutabaga_transfer transfer = { 0 };
+            struct iovec iov;
+
+            if (!vr->scanout_resource[i] || !res || !res->image) {
+                continue;
+            }
+            transfer.w = res->width;
+            transfer.h = res->height;
+            transfer.d = 1;
+            iov.iov_base = pixman_image_get_data(res->image);
+            iov.iov_len = res->width * res->height * 4;
+            if (!rutabaga_resource_transfer_read(vr->rutabaga, 0, res->resource_id,
+                                                 &transfer, &iov)) {
+                dpy_gfx_update_full(vb->scanout[i].con);
+            }
+        }
+    }
+    if (!vr->pending_maps) {
+        return;
+    }
+    for (i = 0; i < vr->pending_maps && i < MAX_SLOTS; i++) {
+        struct rutabaga_mapping mapping = { 0 };
+        MemoryRegion *mr = &vr->memory_regions[i].mr;
+        int ret = rutabaga_resource_map(vr->rutabaga, vr->pending_map_res[i], &mapping);
+
+        if (ret) {
+            error_report("virtio-gpu-rutabaga: re-map of resource %u failed (%d)",
+                         vr->pending_map_res[i], ret);
+            continue;
+        }
+        memory_region_init_ram_ptr(mr, OBJECT(vr), "blob", mapping.size, mapping.ptr);
+        memory_region_add_subregion(&vb->hostmem, vr->pending_map_off[i], mr);
+        vr->memory_regions[i].resource_id = vr->pending_map_res[i];
+        vr->memory_regions[i].used = 1;
+    }
+    vr->pending_maps = 0;
+    g_clear_pointer(&vr->pending_map_res, g_free);
+    g_clear_pointer(&vr->pending_map_off, g_free);
+}
+
+static int virtio_gpu_rutabaga_post_load(void *opaque, int version_id)
+{
+    VirtIOGPU *g = opaque;
+    VirtIOGPUBase *vb = VIRTIO_GPU_BASE(g);
