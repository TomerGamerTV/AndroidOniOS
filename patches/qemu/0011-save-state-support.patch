+{
+    VirtIOSound *s = opaque;
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    uint32_t i;
+
+    for (i = 0; i < s->snd_conf.streams; i++) {
+        VirtIOSoundPCMStream *stream;
+
+        qemu_get_buffer(f, (uint8_t *)&s->pcm->pcm_params[i],
+                        sizeof(s->pcm->pcm_params[i]));
+        if (!qemu_get_byte(f)) {
+            continue;
+        }
+        bool active = qemu_get_byte(f);
+        if (virtio_snd_pcm_prepare(s, i) != cpu_to_le32(VIRTIO_SND_S_OK)) {
+            return -EINVAL;
+        }
+        stream = s->pcm->streams[i];
+        while (qemu_get_byte(f)) {
+            uint32_t vq_index = qemu_get_be32(f);
+            VirtQueueElement *elem;
+            VirtIOSoundPCMBuffer *buffer;
+            uint64_t cap;
 
+            if (vq_index >= VIRTIO_SND_VQ_MAX) {
+                return -EINVAL;
+            }
+            elem = qemu_get_virtqueue_element(vdev, f, sizeof(VirtQueueElement));
+            if (!elem) {
+                return -EINVAL;
+            }
+            uint64_t bsize = qemu_get_be64(f);
+            uint64_t offset = qemu_get_be64(f);
+            bool populated = qemu_get_byte(f);
+            cap = qemu_get_be64(f);
