+static int virtio_snd_save_streams(QEMUFile *f, void *opaque, size_t size,
+                                   const VMStateField *field, JSONWriter *vmdesc)
+{
+    VirtIOSound *s = opaque;
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    VirtIOSoundPCMBuffer *buffer;
+    uint32_t i;
+
+    for (i = 0; i < s->snd_conf.streams; i++) {
+        VirtIOSoundPCMStream *stream = s->pcm->streams[i];
+
+        qemu_put_buffer(f, (const uint8_t *)&s->pcm->pcm_params[i],
+                        sizeof(s->pcm->pcm_params[i]));
+        qemu_put_byte(f, stream != NULL);
+        if (!stream) {
+            continue;
+        }
+        qemu_put_byte(f, stream->active);
+        WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+            QSIMPLEQ_FOREACH(buffer, &stream->queue, entry) {
+                size_t cap = virtio_snd_buffer_capacity(stream, buffer->elem);
+                qemu_put_byte(f, 1);
+                qemu_put_be32(f, virtio_get_queue_index(buffer->vq));
+                qemu_put_virtqueue_element(vdev, f, buffer->elem);
+                qemu_put_be64(f, buffer->size);
+                qemu_put_be64(f, buffer->offset);
+                qemu_put_byte(f, buffer->populated);
+                qemu_put_be64(f, cap);
+                qemu_put_buffer(f, buffer->data, cap);
+            }
+        }
+        qemu_put_byte(f, 0);
+    }
+    return 0;
+}
