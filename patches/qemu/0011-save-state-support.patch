+/*
+ * Migration: per stream, the negotiated parameters, whether it was prepared and running, and
+ * the I/O buffers the device still holds (their virtqueue elements plus any data already copied).
+ * Voices are reopened on load and restarted once the VM runs again.
+ */
+static size_t virtio_snd_buffer_capacity(VirtIOSoundPCMStream *stream,
+                                         VirtQueueElement *elem)
+{
+    size_t n;
+
+    if (stream->info.direction == VIRTIO_SND_D_OUTPUT) {
+        n = iov_size(elem->out_sg, elem->out_num);
+        return n > sizeof(virtio_snd_pcm_xfer) ? n - sizeof(virtio_snd_pcm_xfer) : 0;
+    }
+    n = iov_size(elem->in_sg, elem->in_num);
+    return n > sizeof(virtio_snd_pcm_status) ? n - sizeof(virtio_snd_pcm_status) : 0;
